@{
    ViewData["Title"] = "FiveServices Dashboard";
}

<div class="container py-3">
    <!-- Main Title & Navigation Pills -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cloud-check-fill text-primary"></i> FiveServices 대시보드
            </h2>
            <p class="text-muted mb-0">Supabase DB CRUD 관리 및 Render.com 콜드스타트 방지 / Ping 테스터</p>
        </div>
        <ul class="nav nav-pills" id="mainTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold" id="ping-tab" data-bs-toggle="pill" data-bs-target="#ping-content" type="button" role="tab">
                    🚀 Render Ping & 콜드스타트
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold" id="crud-tab" data-bs-toggle="pill" data-bs-target="#crud-content" type="button" role="tab">
                    📋 Five 테이블 CRUD
                </button>
            </li>
        </ul>
    </div>

    <!-- Alert Message Area -->
    <div id="alertBox" class="alert d-none alert-dismissible fade show" role="alert">
        <span id="alertMessage"></span>
        <button type="button" class="btn-close" onclick="hideAlert()" aria-label="Close"></button>
    </div>

    <!-- Tab Contents -->
    <div class="tab-content" id="mainTabContent">
        
        <!-- TAB 1: PING & COLD START CONTROLS -->
        <div class="tab-pane fade show active" id="ping-content" role="tabpanel">
            <div class="row g-4">
                
                <!-- 1. Client-to-Server Ping Test Card -->
                <div class="col-lg-5">
                    <div class="card shadow-sm mb-4 border-primary">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-broadcast"></i> 수동 즉시 Ping (클라이언트 ➔ 서버)</h6>
                            <span class="badge bg-light text-primary">GET /api/ping</span>
                        </div>
                        <div class="card-body">
                            <p class="small text-muted mb-3">
                                버튼을 누르면 서버로 즉시 Ping을 보내 <strong>응답 지연 시간(Latency)</strong>과 <strong>콜드스타트 여부</strong>, <strong>서버 Uptime</strong>을 실시간으로 측정합니다.
                            </p>
                            <button id="btnManualPing" class="btn btn-primary w-100 py-2 fw-bold mb-3" onclick="sendClientPing()">
                                <i class="bi bi-send-fill"></i> 지금 즉시 Ping 전송 (테스트)
                            </button>

                            <div class="p-3 bg-light rounded border">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">응답 지연 시간:</span>
                                    <strong id="clientLatency">- ms</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">서버 상태:</span>
                                    <span id="clientServerStatus" class="badge bg-secondary">미확인</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">서버 Uptime:</span>
                                    <span id="clientServerUptime" class="fw-semibold">-</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">콜드스타트 감지:</span>
                                    <span id="clientColdStartBadge" class="badge bg-secondary">-</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">서버 환경:</span>
                                    <span id="clientServerEnv" class="badge bg-info text-dark">-</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Browser Keep-Alive Card -->
                    <div class="card shadow-sm border-info">
                        <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-browser-chrome"></i> 브라우저 탭 Keep-Alive (슬립 방지)</h6>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="browserPingToggle" onchange="toggleBrowserPing(this.checked)">
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="small text-muted mb-2">
                                이 페이지를 띄워두는 동안 브라우저가 주기적으로 백그라운드 핑을 보내 Render 서버가 <strong>15분 슬립(Spin Down)</strong>에 들어가지 않도록 깨워둡니다.
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3 p-2 bg-light rounded border">
                                <span>상태: <strong id="browserPingStatus" class="text-secondary">꺼짐</strong></span>
                                <span class="badge bg-secondary" id="browserPingTimer">대기 중</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Server-side Background Worker Controls -->
                <div class="col-lg-7">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-cpu"></i> 서버 백그라운드 자동 Keep-Alive 핑 제어</h6>
                            <span id="serverWorkerStatusBadge" class="badge bg-secondary">조회 중...</span>
                        </div>
                        <div class="card-body">
                            <p class="small text-muted mb-3">
                                서버 자체 백그라운드 서비스(PingService)를 수동으로 <strong>시작 / 정지</strong>하거나 <strong>주기</strong>를 설정하여 외부 URL 또는 자기 자신으로 Ping을 실행하도록 합니다.
                            </p>

                            <div class="row g-2 mb-3">
                                <div class="col-sm-6">
                                    <button id="btnToggleServerWorker" class="btn btn-outline-success w-100 fw-bold" onclick="toggleServerWorker()">
                                        <i class="bi bi-play-circle"></i> 자동 핑 활성화 (시작)
                                    </button>
                                </div>
                                <div class="col-sm-6">
                                    <button class="btn btn-outline-primary w-100 fw-bold" onclick="triggerServerPing()">
                                        <i class="bi bi-arrow-repeat"></i> 서버에서 지금 즉시 1회 발송
                                    </button>
                                </div>
                            </div>

                            <!-- Config Form -->
                            <form id="pingConfigForm" onsubmit="handleSavePingConfig(event)" class="p-3 bg-light rounded border mb-3">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold small">핑 간격 (분)</label>
                                        <select id="configInterval" class="form-select form-select-sm">
                                            <option value="5">5분 마다</option>
                                            <option value="10">10분 마다</option>
                                            <option value="14" selected>14분 마다 (Render 15분 절전 방지 권장)</option>
                                            <option value="20">20분 마다</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">대상 URL (비워두면 내부 /api/ping)</label>
                                        <input type="url" id="configTargetUrl" class="form-control form-control-sm" placeholder="https://fiveservices.onrender.com/api/ping" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-sm btn-dark w-100">저장</button>
                                    </div>
                                </div>
                            </form>

                            <!-- Recent Ping Logs -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold mb-0 small text-uppercase text-muted">최근 서버 핑 실행 기록</h6>
                                <button class="btn btn-sm btn-link p-0 text-decoration-none" onclick="loadServerPingStatus()">
                                    <i class="bi bi-arrow-clockwise"></i> 로그 새로고침
                                </button>
                            </div>
                            <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                                <table class="table table-sm table-hover align-middle mb-0 text-center" style="font-size: 13px;">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>시각</th>
                                            <th>유형</th>
                                            <th>상태</th>
                                            <th>소요시간</th>
                                            <th>결과</th>
                                        </tr>
                                    </thead>
                                    <tbody id="serverPingLogsBody">
                                        <tr>
                                            <td colspan="5" class="text-muted py-2">기록을 불러오는 중...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- TAB 2: FIVE TABLE CRUD (기존 기능) -->
        <div class="tab-pane fade" id="crud-content" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Supabase MyGameDB - Five 테이블 CRUD</h5>
                <button class="btn btn-sm btn-outline-primary" onclick="getAllFives()">
                    <i class="bi bi-arrow-clockwise"></i> 새로고침 (GET All)
                </button>
            </div>

            <div class="row g-4">
                <!-- Left Column: CRUD Controls -->
                <div class="col-lg-6">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-primary text-white d-flex align-items-center py-2">
                            <span class="badge bg-light text-primary me-2">POST</span>
                            <h6 class="mb-0 fw-semibold small">1. 데이터 생성 (POST)</h6>
                        </div>
                        <div class="card-body py-2">
                            <form id="postForm" onsubmit="handlePost(event)">
                                <div class="mb-2">
                                    <input type="text" id="postNote" class="form-control form-control-sm" placeholder="추가할 Note 내용을 입력하세요" maxlength="100" required />
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                    POST 전송 (추가)
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-success text-white d-flex align-items-center py-2">
                            <span class="badge bg-light text-success me-2">GET(id)</span>
                            <h6 class="mb-0 fw-semibold small">2. 단일 데이터 조회 (GET by ID)</h6>
                        </div>
                        <div class="card-body py-2">
                            <form id="getByIdForm" onsubmit="handleGetById(event)">
                                <div class="mb-2">
                                    <input type="number" id="getId" class="form-control form-control-sm" placeholder="ID 입력 (예: 1)" required min="1" />
                                </div>
                                <button type="submit" class="btn btn-sm btn-success w-100">
                                    GET(id) 전송 (조회)
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-warning text-dark d-flex align-items-center py-2">
                            <span class="badge bg-dark text-white me-2">PUT</span>
                            <h6 class="mb-0 fw-semibold small">3. 데이터 수정 (PUT)</h6>
                        </div>
                        <div class="card-body py-2">
                            <form id="putForm" onsubmit="handlePut(event)">
                                <div class="row g-2 mb-2">
                                    <div class="col-4">
                                        <input type="number" id="putId" class="form-control form-control-sm" placeholder="ID" required min="1" />
                                    </div>
                                    <div class="col-8">
                                        <input type="text" id="putNote" class="form-control form-control-sm" placeholder="새로운 Note 내용" maxlength="100" required />
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-sm btn-warning w-100 fw-bold">
                                    PUT 전송 (수정)
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-danger text-white d-flex align-items-center py-2">
                            <span class="badge bg-light text-danger me-2">DELETE</span>
                            <h6 class="mb-0 fw-semibold small">4. 데이터 삭제 (DELETE)</h6>
                        </div>
                        <div class="card-body py-2">
                            <form id="deleteForm" onsubmit="handleDelete(event)">
                                <div class="mb-2">
                                    <input type="number" id="deleteId" class="form-control form-control-sm" placeholder="삭제할 ID 입력" required min="1" />
                                </div>
                                <button type="submit" class="btn btn-sm btn-danger w-100">
                                    DELETE 전송 (삭제)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Table & Response Console -->
                <div class="col-lg-6">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                            <h6 class="mb-0 fw-semibold small">📋 Five 테이블 목록 (GET: /api/fives)</h6>
                            <span id="dataCountBadge" class="badge bg-secondary">0 건</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
                                <table class="table table-hover table-striped align-middle mb-0 text-center" style="font-size: 13px;">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 70px;">ID</th>
                                            <th class="text-start">Note</th>
                                            <th style="width: 120px;">액션</th>
                                        </tr>
                                    </thead>
                                    <tbody id="fivesTableBody">
                                        <tr>
                                            <td colspan="3" class="text-muted py-2">데이터를 불러오는 중입니다...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center py-2">
                            <h6 class="mb-0 fw-semibold small">⚡ 실시간 API 응답 콘솔</h6>
                            <span id="statusBadge" class="badge bg-light text-dark">대기 중</span>
                        </div>
                        <div class="card-body bg-light font-monospace py-2">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="text-muted" id="lastApiInfo">호출 기록 없음</small>
                                <small class="text-muted" id="lastApiTime"></small>
                            </div>
                            <pre id="responseJson" class="p-2 bg-dark text-light rounded mb-0" style="min-height: 180px; max-height: 220px; overflow: auto; font-size: 12px;">// 테스트 버튼을 클릭하면 여기에 응답 데이터가 표시됩니다.</pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    const API_URL = '/api/fives';
    const PING_API_URL = '/api/ping';

    let isServerAutoPing = false;
    let browserPingIntervalId = null;
    let browserCountdownId = null;
    let countdownSeconds = 600; // 10분

    document.addEventListener('DOMContentLoaded', () => {
        loadServerPingStatus();
        getAllFives();
    });

    function showAlert(message, type = 'success') {
        const alertBox = document.getElementById('alertBox');
        const alertMessage = document.getElementById('alertMessage');
        alertBox.className = `alert alert-${type} alert-dismissible fade show`;
        alertMessage.textContent = message;
        alertBox.classList.remove('d-none');
    }

    function hideAlert() {
        document.getElementById('alertBox').classList.add('d-none');
    }

    // ==========================================
    // 1. PING & COLD START FUNCTIONS
    // ==========================================

    // 수동 클라이언트 Ping 전송
    async function sendClientPing() {
        const btn = document.getElementById('btnManualPing');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Ping 측정 중...';

        const startTime = performance.now();
        try {
            const res = await fetch(PING_API_URL + '?t=' + Date.now());
            const endTime = performance.now();
            const latency = Math.round(endTime - startTime);

            const data = await res.json();

            // UI 갱신
            const latencyElem = document.getElementById('clientLatency');
            latencyElem.textContent = `${latency} ms`;
            if (latency > 5000) {
                latencyElem.className = 'text-danger fw-bold';
            } else if (latency > 1000) {
                latencyElem.className = 'text-warning fw-bold';
            } else {
                latencyElem.className = 'text-success fw-bold';
            }

            const statusBadge = document.getElementById('clientServerStatus');
            statusBadge.textContent = data.status || 'OK';
            statusBadge.className = 'badge bg-success';

            document.getElementById('clientServerUptime').textContent = data.uptime || '-';

            const coldBadge = document.getElementById('clientColdStartBadge');
            if (data.isColdStart || latency > 4000) {
                coldBadge.textContent = '콜드스타트 직후 감지';
                coldBadge.className = 'badge bg-warning text-dark';
            } else {
                coldBadge.textContent = '정상 가동 중 (Warm)';
                coldBadge.className = 'badge bg-success';
            }

            document.getElementById('clientServerEnv').textContent = data.environment || 'Production';

            showAlert(`Ping 성공! 지연 시간: ${latency}ms (상태: ${data.status})`);
        } catch (err) {
            console.error(err);
            showAlert('Ping 전송 실패: ' + err.message, 'danger');
            document.getElementById('clientServerStatus').textContent = '오류';
            document.getElementById('clientServerStatus').className = 'badge bg-danger';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send-fill"></i> 지금 즉시 Ping 전송 (테스트)';
        }
    }

    // 서버 Ping 백그라운드 상태 조회
    async function loadServerPingStatus() {
        try {
            const res = await fetch(`${PING_API_URL}/status`);
            const data = await res.json();

            isServerAutoPing = data.isAutoPingEnabled;
            updateServerPingUI(data);
        } catch (err) {
            console.error(err);
        }
    }

    function updateServerPingUI(data) {
        const statusBadge = document.getElementById('serverWorkerStatusBadge');
        const toggleBtn = document.getElementById('btnToggleServerWorker');

        if (data.isAutoPingEnabled) {
            statusBadge.textContent = `활성화 (매 ${data.intervalMinutes}분)`;
            statusBadge.className = 'badge bg-success';
            toggleBtn.className = 'btn btn-outline-danger w-100 fw-bold';
            toggleBtn.innerHTML = '<i class="bi bi-stop-circle"></i> 자동 핑 비활성화 (중지)';
        } else {
            statusBadge.textContent = '비활성화 (중지됨)';
            statusBadge.className = 'badge bg-secondary';
            toggleBtn.className = 'btn btn-outline-success w-100 fw-bold';
            toggleBtn.innerHTML = '<i class="bi bi-play-circle"></i> 자동 핑 활성화 (시작)';
        }

        document.getElementById('configInterval').value = data.intervalMinutes || 14;
        if (data.targetUrl) {
            document.getElementById('configTargetUrl').value = data.targetUrl;
        }

        // 로그 테이블 렌더링
        const tbody = document.getElementById('serverPingLogsBody');
        tbody.innerHTML = '';
        if (!data.recentLogs || data.recentLogs.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-muted py-2">아직 실행된 핑 기록이 없습니다.</td></tr>';
            return;
        }

        data.recentLogs.forEach(log => {
            const tr = document.createElement('tr');
            const timeStr = new Date(log.timestamp).toLocaleTimeString();
            const badgeClass = log.isSuccess ? 'bg-success' : 'bg-danger';
            const typeBadge = log.isManual ? '<span class="badge bg-primary">수동</span>' : '<span class="badge bg-secondary">자동</span>';

            tr.innerHTML = `
                <td>${timeStr}</td>
                <td>${typeBadge}</td>
                <td><span class="badge ${badgeClass}">${log.statusCode || 'Err'}</span></td>
                <td>${log.durationMs}ms</td>
                <td class="text-truncate" style="max-width: 160px;" title="${escapeHtml(log.message)}">${escapeHtml(log.message)}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    // 서버 자동 핑 시작/중지 토글
    async function toggleServerWorker() {
        const nextState = !isServerAutoPing;
        try {
            const res = await fetch(`${PING_API_URL}/configure`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ enabled: nextState })
            });
            const data = await res.json();
            showAlert(`서버 자동 핑이 ${nextState ? '시작' : '중지'}되었습니다.`);
            loadServerPingStatus();
        } catch (err) {
            showAlert('설정 변경 실패: ' + err.message, 'danger');
        }
    }

    // 서버에서 지금 즉시 1회 발송 트리거
    async function triggerServerPing() {
        try {
            showAlert('서버에서 Ping을 발송 중입니다...', 'info');
            const res = await fetch(`${PING_API_URL}/send`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({})
            });
            const result = await res.json();
            showAlert(`서버 Ping 완료: ${result.message} (${result.durationMs}ms)`);
            loadServerPingStatus();
        } catch (err) {
            showAlert('서버 Ping 발송 실패: ' + err.message, 'danger');
        }
    }

    // 서버 핑 설정 저장
    async function handleSavePingConfig(e) {
        e.preventDefault();
        const interval = parseInt(document.getElementById('configInterval').value, 10);
        const targetUrl = document.getElementById('configTargetUrl').value;

        try {
            const res = await fetch(`${PING_API_URL}/configure`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    intervalMinutes: interval,
                    targetUrl: targetUrl || null
                })
            });
            const data = await res.json();
            showAlert('Ping 설정이 저장되었습니다.');
            loadServerPingStatus();
        } catch (err) {
            showAlert('저장 실패: ' + err.message, 'danger');
        }
    }

    // 브라우저 Keep-Alive 토글
    function toggleBrowserPing(enabled) {
        const statusElem = document.getElementById('browserPingStatus');
        const timerElem = document.getElementById('browserPingTimer');

        if (enabled) {
            statusElem.textContent = '작동 중 (10분 주기)';
            statusElem.className = 'text-success fw-bold';
            countdownSeconds = 600;

            browserCountdownId = setInterval(() => {
                countdownSeconds--;
                if (countdownSeconds <= 0) {
                    countdownSeconds = 600;
                    fetch(PING_API_URL + '?browserKeepAlive=1');
                }
                const min = Math.floor(countdownSeconds / 60);
                const sec = countdownSeconds % 60;
                timerElem.textContent = `다음 핑: ${min}분 ${sec}초`;
            }, 1000);

            showAlert('브라우저 Keep-Alive 핑이 활성화되었습니다. 이 탭을 켜두시면 Render가 절전 모드로 들어가지 않습니다.');
        } else {
            statusElem.textContent = '꺼짐';
            statusElem.className = 'text-secondary';
            timerElem.textContent = '대기 중';
            clearInterval(browserCountdownId);
            showAlert('브라우저 Keep-Alive 핑이 비활성화되었습니다.', 'secondary');
        }
    }

    // ==========================================
    // 2. FIVE TABLE CRUD FUNCTIONS
    // ==========================================

    function setConsole(method, url, status, data) {
        document.getElementById('lastApiInfo').innerHTML = `<strong class="text-primary">${method}</strong> ${url}`;
        document.getElementById('lastApiTime').textContent = new Date().toLocaleTimeString();

        const badge = document.getElementById('statusBadge');
        badge.textContent = `Status: ${status}`;
        if (status >= 200 && status < 300) {
            badge.className = 'badge bg-success text-white';
        } else {
            badge.className = 'badge bg-danger text-white';
        }

        document.getElementById('responseJson').textContent = JSON.stringify(data, null, 2);
    }

    async function getAllFives() {
        try {
            const res = await fetch(API_URL);
            const data = await res.json();
            setConsole('GET', API_URL, res.status, data);

            const tbody = document.getElementById('fivesTableBody');
            const countBadge = document.getElementById('dataCountBadge');
            tbody.innerHTML = '';

            if (!Array.isArray(data) || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-muted py-2">데이터가 없습니다.</td></tr>';
                countBadge.textContent = '0 건';
                return;
            }

            countBadge.textContent = `${data.length} 건`;

            data.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${item.id}</strong></td>
                    <td class="text-start">${escapeHtml(item.note)}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-warning me-1 py-0 px-2" onclick="selectForEdit(${item.id}, '${escapeJs(item.note)}')">
                            선택
                        </button>
                        <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="quickDelete(${item.id})">
                            삭제
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        } catch (err) {
            console.error(err);
            setConsole('GET', API_URL, 'Error', { error: err.message });
        }
    }

    async function handleGetById(e) {
        e.preventDefault();
        const id = document.getElementById('getId').value;
        if (!id) return;

        try {
            const res = await fetch(`${API_URL}/${id}`);
            const data = await res.json();
            setConsole('GET', `${API_URL}/${id}`, res.status, data);

            if (res.ok) {
                showAlert(`ID ${id} 데이터 조회 성공!`);
                selectForEdit(data.id, data.note);
            } else {
                showAlert(`조회 실패: ${data.message || '데이터를 찾을 수 없습니다.'}`, 'warning');
            }
        } catch (err) {
            showAlert('조회 중 오류가 발생했습니다.', 'danger');
            setConsole('GET', `${API_URL}/${id}`, 'Error', { error: err.message });
        }
    }

    async function handlePost(e) {
        e.preventDefault();
        const note = document.getElementById('postNote').value;
        if (!note) return;

        try {
            const res = await fetch(API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ note: note })
            });
            const data = await res.json();
            setConsole('POST', API_URL, res.status, data);

            if (res.ok) {
                showAlert(`새 데이터 등록 성공! (ID: ${data.id})`);
                document.getElementById('postNote').value = '';
                getAllFives();
            } else {
                showAlert('등록 실패: ' + JSON.stringify(data), 'danger');
            }
        } catch (err) {
            showAlert('데이터 등록 중 오류가 발생했습니다.', 'danger');
            setConsole('POST', API_URL, 'Error', { error: err.message });
        }
    }

    async function handlePut(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('putId').value, 10);
        const note = document.getElementById('putNote').value;
        if (!id || !note) return;

        try {
            const res = await fetch(`${API_URL}/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, note: note })
            });
            const data = await res.json();
            setConsole('PUT', `${API_URL}/${id}`, res.status, data);

            if (res.ok) {
                showAlert(`ID ${id} 데이터가 성공적으로 수정되었습니다!`);
                getAllFives();
            } else {
                showAlert(`수정 실패: ${data.message || '오류 발생'}`, 'warning');
            }
        } catch (err) {
            showAlert('데이터 수정 중 오류가 발생했습니다.', 'danger');
            setConsole('PUT', `${API_URL}/${id}`, 'Error', { error: err.message });
        }
    }

    async function handleDelete(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('deleteId').value, 10);
        if (!id) return;
        await executeDelete(id);
    }

    async function quickDelete(id) {
        if (!confirm(`ID ${id} 데이터를 정말로 삭제하시겠습니까?`)) return;
        await executeDelete(id);
    }

    async function executeDelete(id) {
        try {
            const res = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
            const data = await res.json();
            setConsole('DELETE', `${API_URL}/${id}`, res.status, data);

            if (res.ok) {
                showAlert(`ID ${id} 데이터가 삭제되었습니다.`);
                document.getElementById('deleteId').value = '';
                getAllFives();
            } else {
                showAlert(`삭제 실패: ${data.message || '오류 발생'}`, 'warning');
            }
        } catch (err) {
            showAlert('데이터 삭제 중 오류가 발생했습니다.', 'danger');
            setConsole('DELETE', `${API_URL}/${id}`, 'Error', { error: err.message });
        }
    }

    function selectForEdit(id, note) {
        document.getElementById('putId').value = id;
        document.getElementById('putNote').value = note;
        document.getElementById('deleteId').value = id;
        document.getElementById('getId').value = id;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    function escapeJs(str) {
        if (!str) return '';
        return str.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"');
    }
</script>
}
